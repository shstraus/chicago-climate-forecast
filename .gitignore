# =============================================================================
# Secrets: never commit these
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# =============================================================================
# Data
# Raw and interim data are regenerated by scripts (see Makefile), so they are
# not versioned. The .gitkeep files preserve the folder structure.
# data/provenance/ IS committed: it is the small log of what was downloaded,
# when, from where, and its checksum.
# =============================================================================
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Processed data: small, final tables may be committed. Large files may not.
# Anything over ~50 MB should live outside git (university storage, DVC, etc.).
# Uncomment to ignore all processed data instead:
# data/processed/*
# !data/processed/.gitkeep

# Large scientific / binary formats, ignored anywhere in the repo
*.nc
*.nc4
*.grib
*.grib2
*.zarr/
*.h5
*.hdf5
*.tif
*.tiff
*.parquet
*.feather
*.gpkg
*.shp
*.shx
*.dbf
*.zip
*.tar
*.tar.gz
*.gz

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments (conda envs live outside the repo, but just in case)
.venv/
venv/
env/

# =============================================================================
# Jupyter
# =============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# =============================================================================
# Editors and OS
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# =============================================================================
# Misc
# =============================================================================
dask-worker-space/
*.log
*.tmp
